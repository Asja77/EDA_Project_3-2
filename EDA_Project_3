-----------------------------------------------------\n# Создаем признаки на основе национальности ревьюера (на train данных!)\nnationality_stats = df[df['is_train'] == 1].groupby('reviewer_nationality')['reviewer_score'].agg(['mean', 'count']).reset_index()\nnationality_stats.columns = ['reviewer_nationality', 'nationality_mean_score', 'nationality_review_count']\n\n# Присоединяем новые признаки к основному датафрейму\ndf = df.merge(nationality_stats, on='reviewer_nationality', how='left')\n\nprint(\"✅ Созданы признаки на основе национальности ревьюера.\")\n\n\n# Убедимся, что колонка 'days_since_review' имеет числовой тип данных\ndf['days_since_review'] = pd.to_numeric(df['days_since_review'], errors='coerce')\n\n# -----------------------------------------------------------------------------\n# 6.2. КОРРЕЛЯЦИОННЫЙ АНАЛИЗ (НА ТРЕНИРОВОЧНЫХ ДАННЫХ)\n# -----------------------------------------------------------------------------\n# Отбираем только числовые признаки и только для train выборки\ntrain_df = df[df['is_train'] == 1]\nnumeric_cols = train_df.select_dtypes(include=np.number).columns\ncorrelation_matrix = train_df[numeric_cols].corr()\n\n# Корреляция всех числовых признаков с целевой переменной\ntarget_corr = correlation_matrix['reviewer_score'].sort_values(ascending=False)\nprint(\"\\n🎯 Корреляция признаков с 'reviewer_score':\")\ndisplay(target_corr.round(3))\n\n# -----------------------------------------------------------------------------\n# 6.3. ВИЗУАЛИЗАЦИЯ КОРРЕЛЯЦИЙ (HEATMAP)\n# -----------------------------------------------------------------------------\n# Выберем самые интересные признаки для наглядности\ntop_corr_features = target_corr.abs().sort_values(ascending=False).head(12).index\nplt.figure(figsize=(12, 10))\nsns.heatmap(train_df[top_corr_features].corr(), annot=True, fmt='.2f', cmap='coolwarm', center=0)\nplt.title('Матрица корреляций ключевых числовых признаков', fontsize=16)\nplt.show()\n\n# -----------------------------------------------------------------------------\n# 6.4. ВИЗУАЛИЗАЦИЯ КЛЮЧЕВЫХ ЗАВИСИМОСТЕЙ\n# -----------------------------------------------------------------------------\n# Возьмем случайную выборку для наглядности графиков\ntrain_sample = train_df.sample(n=10000, random_state=42)\n\nfig, axes = plt.subplots(2, 2, figsize=(16, 12))\nfig.suptitle('Анализ ключевых зависимостей (на выборке 10k)', fontsize=18)\n\n# 1. Средняя оценка отеля vs Оценка ревьюера (самый сильный признак)\nsns.regplot(data=train_sample, x='average_score', y='reviewer_score', ax=axes[0, 0],\n            scatter_kws={'alpha':0.2, 's':10}, line_kws={'color':'red'})\naxes[0, 0].set_title('Средняя оценка отеля vs. Оценка ревьюера', fontsize=14)\naxes[0, 0].set_xlabel('Average Score отеля')\naxes[0, 0].set_ylabel('Reviewer Score')\n\n# 2. Длина негативного отзыва vs Оценка ревьюера\nsns.regplot(data=train_sample, x='neg_review_word_count', y='reviewer_score', ax=axes[0, 1],\n            scatter_kws={'alpha':0.2, 's':10, 'color':'#E57373'}, line_kws={'color':'#B71C1C'})\naxes[0, 1].set_title('Количество слов в негативном отзыве vs. Оценка', fontsize=14)\naxes[0, 1].set_xlabel('Кол-во слов в негативном отзыве')\naxes[0, 1].set_ylabel('Reviewer Score')\n\n# 3. Опыт ревьюера vs Оценка\nsns.regplot(data=train_sample, x='total_number_of_reviews_reviewer_has_given', y='reviewer_score', ax=axes[1, 0],\n            scatter_kws={'alpha':0.2, 's':10, 'color':'#64B5F6'}, line_kws={'color':'#1565C0'})\naxes[1, 0].set_title('Опыт ревьюера vs. Оценка', fontsize=14)\naxes[1, 0].set_xlabel('Сколько всего отзывов оставил ревьюер')\naxes[1, 0].set_ylabel('Reviewer Score')\naxes[1, 0].set_xlim(0, 100) # Ограничим для наглядности\n\n# 4. \"Свежесть\" отзыва vs Оценка\nsns.regplot(data=train_sample, x='days_since_review', y='reviewer_score', ax=axes[1, 1],\n            scatter_kws={'alpha':0.2, 's':10, 'color':'#81C784'}, line_kws={'color':'#2E7D32'})\naxes[1, 1].set_title('\"Свежесть\" отзыва vs. Оценка', fontsize=14)\naxes[1, 1].set_xlabel('Дней с момента публикации отзыва')\naxes[1, 1].set_ylabel('Reviewer Score')\n\nplt.tight_layout(rect=[0, 0.03, 1, 0.95])\nplt.show()\n","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"N2AmFj4WfIcZ","outputId":"ab0b26b1-6762-430d-c9dc-c9221216247a"},"outputs":[{"output_type":"stream","name":"stdout","text":["--- 📊 Финальный анализ факторов, влияющих на оценку ---\n","✅ Созданы признаки на основе национальности ревьюера.\n","\n","🎯 Корреляция признаков с 'reviewer_score':\n"]},{"output_type":"display_data","data":{"text/plain":["reviewer_score                                1.000\n","average_score                                 0.364\n","pos_review_len                                0.232\n","review_total_positive_word_counts             0.220\n","pos_review_word_count                         0.215\n","nationality_mean_score                        0.139\n","nationality_review_count                      0.059\n","country_mean_score                            0.054\n","city_mean_score                               0.054\n","lng                                           0.035\n","num_tags                                      0.024\n","total_number_of_reviews_reviewer_has_given    0.003\n","nights_stayed                                -0.015\n","lat                                          -0.037\n","city_review_count                            -0.043\n","country_review_count                         -0.043\n","additional_number_of_scoring                 -0.062\n","total_number_of_reviews                      -0.073\n","total_review_word_count                      -0.170\n","has_negative_review                          -0.332\n","neg_review_word_count                        -0.380\n","review_total_negative_word_counts            -0.383\n","neg_review_len                               -0.386\n","days_since_review                               NaN\n","is_train                                        NaN\n","Name: reviewer_score, dtype: 