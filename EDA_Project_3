es\": [\n          330011,\n          \"127807\",\n          \"515402\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"positive_review\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 4,\n        \"samples\": [\n          412601,\n          \"35923\",\n          \"515402\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"tags\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 4,\n        \"samples\": [\n          55242,\n          \"5101\",\n          \"515402\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"days_since_review\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 4,\n        \"samples\": [\n          731,\n          \"2584\",\n          \"515402\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}}],"execution_count":null},{"cell_type":"markdown","source":"Анализ целевой переменной","metadata":{"id":"DfB00eE6d6Yj"}},{"cell_type":"code","source":"# =============================================================================\n# 🚀 ЭТАП 2: АНАЛИЗ ЦЕЛЕВОЙ ПЕРЕМЕННОЙ (REVIEWER_SCORE)\n# =============================================================================\nprint(\"--- 🎯 Анализ целевой переменной (reviewer_score) ---\")\n\n# -----------------------------------------------------------------------------\n# 2.1. ВЫБОРКА ЦЕЛЕВОЙ ПЕРЕМЕННОЙ (ТОЛЬКО ИЗ TRAIN ДАННЫХ!)\n# -----------------------------------------------------------------------------\ntarget = df[df['is_train'] == 1]['reviewer_score']\nprint(\"Статистика по 'reviewer_score':\")\ndisplay(target.describe())\n\n# -----------------------------------------------------------------------------\n# 2.2. ВИЗУАЛИЗАЦИЯ РАСПРЕДЕЛЕНИЯ\n# -----------------------------------------------------------------------------\nfig, axes = plt.subplots(2, 2, figsize=(16, 12))\nfig.suptitle('Всесторонний анализ целевой переменной (Reviewer Score)', fontsize=16)\n\n# Гистограмма + KDE (Kernel Density Estimate)\nsns.histplot(target, bins=50, kde=True, ax=axes[0, 0], color='skyblue')\naxes[0, 0].set_title('Гистограмма и кривая плотности распределения')\naxes[0, 0].set_xlabel('Оценка (Reviewer Score)')\naxes[0, 0].set_ylabel('Частота')\naxes[0, 0].axvline(target.mean(), color='red', linestyle='--', label=f'Среднее: {target.mean():.2f}')\naxes[0, 0].axvline(target.median(), color='green', linestyle='-', label=f'Медиана: {target.median():.2f}')\naxes[0, 0].legend()\n\n# Boxplot (Диаграмма размаха) для поиска выбросов\nsns.boxplot(x=target, ax=axes[0, 1], color='lightgreen')\naxes[0, 1].set_title(\"Диаграмма размаха ('Ящик с усами')\")\naxes[0, 1].set_xlabel('Оценка (Reviewer Score)')\n\n# Q-Q plot для проверки на нормальность\nstats.probplot(target, dist=\"norm\", plot=axes[1, 0])\naxes[1, 0].set_title('Q-Q Plot (сравнение с нормальным распределением)')\n\n# Violin plot (комбинация Boxplot и KDE)\nsns.violinplot(x=target, ax=axes[1, 1], color='plum')\naxes[1, 1].set_title('Violin Plot (плотность + размах)')\naxes[1, 1].set_xlabel('Оценка (Reviewer Score)')\n\nplt.tight_layout(rect=[0, 0.03, 1, 0.95])\nplt.show()\n\n# -----------------------------------------------------------------------------\n# 2.3. СТАТИСТИЧЕСКИЙ ТЕСТ НА НОРМАЛЬНОСТЬ\n# -----------------------------------------------------------------------------\n# Для теста Шапиро-Уилка рекомендуется выборка < 5000\n# Берем случайную выборку для ускорения и корректности теста\nshapiro_sample = target.sample(4999, random_state=42)\nshapiro_stat, shapiro_p = stats.shapiro(shapiro_sample)\n\nprint(f\"\\n🔬 Тест Шапиро-Уилка на нормальность (на выборке из {len(shapiro_sample)} записей):\")\nprint(f\"Статистика = {shapiro_stat:.4f}\")\nprint(f\"P-value = {shapiro_p:.4e}\") # Вывод в научной нотации, т.к. p-value очень мал\n\nif shapiro_p < 0.05:\n    print(\"✅ Вывод: Распределение НЕ является нормальным (p-value < 0.05).\")\nelse:\n    print(\"✅ Вывод: Гипотезу о нормальности распределения отвергнуть не удалось (p-value >= 0.05).\")","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"KOttWp5bd9NZ","outputId":"d2bd7ced-45da-483b-e1ec-fb8f277a9f26"},"outputs":[{"output_type":"stream","name":"stdout","text":["--- 🎯 Анализ целевой переменной (reviewer_score) ---\n","Статистика по 'reviewer_score':\n"]},{"output_type":"display_data","data":{"text/plain":["count   386496.000\n","mean         8.397\n","std          1.636\n","min          2.500\n","25%          7.500\n","50%          8.800\n","75%          9.600\n","max         10.000\n","Name: reviewer_score, dtype: float64"],"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>reviewer_score</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>count</th>\n","      <td>386496.000</td>\n","    </tr>\n","    <tr>\n","      <th>mean</th>\n","      <td>8.397</td>\n","    </tr>\n","    <tr>\n","      <th>std</th>\n","      <td>1.636</td>\n","    </tr>\n","    <tr>\n","      <th>min</th>\n","      <td>2.500</td>\n","    </tr>\n","    <tr>\n","      <th>25%</th>\n","      <td>7.500</td>\n","    </tr>\n","    <tr>\n","      <th>50%</th>\n","      <td>8.800</td>\n","    </tr>\n","    <tr>\n","      <th>75%</th>\n","      <td>9.600</td>\n","    </tr>\n","    <tr>\n","      <th>max</th>\n","      <td>10.000</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div><br><label><b>dtype:</b> float64</label>"]},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 1600x1200 with 4 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","🔬 Тест Шапиро-Уилка на нормальность (на выборке из 4999 записей):\n","Статистика = 0.8603\n","P-value = 5.3118e-55\n","✅ Вывод: Распределение НЕ является нормальным (p-value < 0.05).\n"]}],"execution_count":2},{"cell_type":"markdown","source":"Географический анализ","metadata":{"id":"1OBZDoKCeK9Z"}},{"cell_type":"code","source":"# =============================================================================\n# 🚀 ЭТАП 3: ГЕОГРАФИЧЕСКИЙ АНАЛИЗ И FEATURE ENGINEERING\n# =============================================================================\nprint(\"--- 🌍 Географический анализ и создание признаков ---\")\n\n# -----------------------------------------------------------------------------\n# 3.1. ИЗВЛЕЧЕНИЕ СТРАНЫ И ГОРОДА ИЗ АДРЕСА\n# -----------------------------------------------------------------------------\n# Убираем лишние пробелы в начале/конце адреса\ndf['hotel_address'] = df['hotel_address'].str.strip()\n\n# Извлекаем страну\n# Последнее слово в адресе - это страна.\ndf['hotel_country'] = df['hotel_address'].apply(lambda x: x.split(' ')[-1])\n# Особый случай для 'Kingdom', которое является частью 'United Kingdom'\ndf['hotel_country'] = df['hotel_country'].replace('Kingdom', 'United Kingdom')\n\n# Извлекаем город (более надежный способ)\n# Город - это предпоследнее слово для большинства стран\n# или 4-е с конца для 'United Kingdom' (e.g., ... London SW1A 0AA United Kingdom)\naddress_parts = df['hotel_address'].str.split(' ')\ndf['hotel_city'] = address_parts.str.get(-2)\ndf.loc[df['hotel_country'] == 'United Kingdom', 'hotel_city'] = address_parts[df['hotel_country'] == 'United Kingdom'].str.get(-5)\n\nprint(\"✅ Признаки 'hotel_country' и 'hotel_city' созданы.\")\nprint(\"Уникальные страны:\", df['hotel_country'].unique())\nprint(\"Уникальные города:\", df['hotel_city'].unique())\n\n# -----------------------------------------------------------------------------\n# 3.2. АНАЛИЗ РАСПРЕДЕЛЕНИЯ ОТЕЛЕЙ ПО ГОРОДАМ\n# -----------------------------------------------------------------------------\ncity_counts = df['hotel_city'].value_counts()\n\nplt.figure(figsize=(12, 8))\nsns.barplot(y=city_counts.index, x=city_counts.values, palette='viridis', orient='h')\nplt.title('Количество отзывов по городам', fontsize=16)\nplt.xlabel('Количество отзывов', fontsize=12)\nplt.ylabel('Город', fontsize=12)\nplt.grid(axis='x', linestyle='--', alpha=0.7)\nplt.show()\n\n# -----------------------------------------------------------------------------\n# 3.3. СОЗДАНИЕ НОВЫХ ПРИЗНАКОВ НА ОСНОВЕ ГЕОГРАФИИ\n# -----------------------------------------------------------------------------\n# Группируем ТОЛЬКО по ТРЕНИРОВОЧНЫМ данным, чтобы избежать утечки данных!\ncity_stats = df[df['is_train'] == 1].groupby('hotel_city')['reviewer_score'].agg(['mean', 'count']).reset_index()\ncity_stats.columns = ['hotel_city', 'city_mean_score', 'city_review_count']\n\ncountry_stats = df[df['is_train'] == 1].groupby('hotel_country')['reviewer_score'].agg(['mean', 'count']).reset_index()\ncountry_stats.columns = ['hotel_country', 'country_mean_score', 'country_review_count']\n\n# Мерджим (присоединяем) новые признаки к основному датафрейму\ndf = df.merge(city_stats, on='hotel_city', how='left')\ndf = df.merge(country_stats, on='hotel_country', how='left')\n\nprint(\"\\n✅ Созданы и добавлены новые признаки:\")\nprint(\"  - 'city_mean_score': Средний рейтинг по городу\")\nprint(\"  - 'city_review_count': Количество отзывов по городу\")\nprint(\"  - 'country_mean_score': Средний рейтинг по стране\")\nprint(\"  - 'country_review_count': Количество отзывов по стране\")\ndisplay(df[['hotel_city', 'hotel_country', 'city_mean_score', 'city_review_count', 'country_mean_score']].head())\n\n# -----------------------------------------------------------------------------\n# 3.4. ВИЗУАЛИЗАЦИЯ СРЕДНЕЙ ОЦЕНКИ ПО ГОРОДАМ\n# -----------------------------------------------------------------------------\n# Используем уже посчитанные агрегаты для графика\ncity_means = city_stats.set_index('hotel_city')['city_mean_score'].sort_values(ascending=False)\n\nplt.figure(figsize=(12, 7))\n# Устанавливаем диапазон y-оси для лучшей видимости разницы\ny_min = city_means.min() - 0.1\ny_max = city_means.max() + 0.1\n\nax = sns.barplot(x=city_means.index, y=city_means.values, palette='coolwarm')\nax.set_ylim(y_min, y_max)\n\n# Добавляем общую среднюю линию для сравнения\noverall_mean = df[df['is_train'] == 1]['reviewer_score'].mean()\nax.axhline(overall_mean, ls='--', color='black', label=f'Общая средняя: {overall_mean:.2f}')\n\n# Добавляем значения на столбцы\nfor p in ax.patches:\n    ax.annotate(f'{p.get_height():.2f}',\n                (p.get_x() + p.get_width() / 2., p.get_height()),\n                ha='center', va='center',\n                xytext=(0, 9),\n                textcoords='offset points')\n\nplt.title('Средняя оценка отелей по городам (на тренировочных данных)', fontsize=16)\nplt.xlabel('Город', fontsize=12)\nplt.ylabel('Средняя оценка', fontsize=12)\nplt.xticks(rotation=45, ha='right')\nplt.legend()\nplt.tight_layout()\nplt.show()\n","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"qCJ3UnVLeVRy","outputId":"22f1f779-9bc5-4192-ac5b-4ac40801138c"},"outputs":[{"output_type":"stream","name":"stdout","text":["--- 🌍 Географический анализ и создание признаков ---\n","✅ Признаки 'hotel_country' и 'hotel_city' созданы.\n","Уникальные страны: ['United Kingdom' 'France' 'Netherlands' 'Italy' 'Austria' 'Spain']\n","Уникальные города: ['London' 'Paris' 'Amsterdam' 'Milan' 'Vienna' 'Barcelona']\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x800 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\