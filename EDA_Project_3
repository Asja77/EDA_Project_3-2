nprint(\"  - ..._word_count: количество слов в отзыве\")\nprint(\"  - total_review_word_count: общее количество слов\")\nprint(\"  - has_negative_review: бинарный флаг наличия негативного отзыва\")\ndisplay(df[['pos_review_word_count', 'neg_review_word_count', 'has_negative_review']].describe())\n\n# -----------------------------------------------------------------------------\n# 4.3. ВИЗУАЛИЗАЦИЯ РАСПРЕДЕЛЕНИЙ\n# -----------------------------------------------------------------------------\nfig, axes = plt.subplots(1, 2, figsize=(16, 6))\nfig.suptitle('Распределение количества слов в отзывах', fontsize=16)\n\n# Положительные отзывы\nsns.histplot(df['pos_review_word_count'], bins=50, ax=axes[0], color='green', kde=True)\naxes[0].set_title('Положительные отзывы')\naxes[0].set_xlabel('Количество слов')\naxes[0].set_xlim(0, 200) # Ограничим для наглядности\n\n# Отрицательные отзывы\nsns.histplot(df['neg_review_word_count'], bins=50, ax=axes[1], color='red', kde=True)\naxes[1].set_title('Отрицательные отзывы')\naxes[1].set_xlabel('Количество слов')\naxes[1].set_xlim(0, 200) # Ограничим для наглядности\n\nplt.show()\n\n# -----------------------------------------------------------------------------\n# 4.4. АНАЛИЗ ВЗАИМОСВЯЗИ С ОЦЕНКОЙ (НА ТРЕНИРОВОЧНЫХ ДАННЫХ)\n# -----------------------------------------------------------------------------\n# Берем только train данные для анализа\ntrain_sample = df[df['is_train'] == 1].sample(n=5000, random_state=42)\n\nfig, axes = plt.subplots(1, 2, figsize=(16, 7))\nfig.suptitle('Взаимосвязь количества слов и итоговой оценки (на выборке 5000)', fontsize=16)\n\n# Положительные слова vs Оценка\nsns.regplot(data=train_sample, x='pos_review_word_count', y='reviewer_score',\n            ax=axes[0], color='green',\n            scatter_kws={'alpha':0.3, 's':10}, line_kws={'color':'darkgreen'})\naxes[0].set_title('Положительные слова vs Оценка')\naxes[0].set_xlabel('Количество слов в положительном отзыве')\naxes[0].set_ylabel('Оценка')\n\n# Отрицательные слова vs Оценка\nsns.regplot(data=train_sample, x='neg_review_word_count', y='reviewer_score',\n            ax=axes[1], color='red',\n            scatter_kws={'alpha':0.3, 's':10}, line_kws={'color':'darkred'})\naxes[1].set_title('Отрицательные слова vs Оценка')\naxes[1].set_xlabel('Количество слов в отрицательном отзыве')\naxes[1].set_ylabel('Оценка')\n\nplt.show()\n\n# -----------------------------------------------------------------------------\n# 4.5. РАСЧЕТ КОРРЕЛЯЦИИ (НА ТРЕНИРОВОЧНЫХ ДАННЫХ)\n# -----------------------------------------------------------------------------\ntrain_df = df[df['is_train'] == 1]\nprint(f\"\\n📈 Корреляция с оценкой (на тренировочных данных):\")\ncorr_pos = train_df['pos_review_word_count'].corr(train_df['reviewer_score'])\ncorr_neg = train_df['neg_review_word_count'].corr(train_df['reviewer_score'])\nprint(f\"  - Количество положительных слов: {corr_pos:.3f}\")\nprint(f\"  - Количество отрицательных слов: {corr_neg:.3f}\")","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"ZrQ-LyIFemqK","outputId":"de5b802b-8d6b-46f2-e74b-1e3068310e91"},"outputs":[{"output_type":"stream","name":"stdout","text":["--- ✍️ Анализ текстовых отзывов и создание признаков ---\n","✅ Текстовые 'заглушки' заменены на пустые строки.\n","✅ Созданы новые текстовые признаки:\n","  - ..._len: длина отзыва в символах\n","  - ..._word_count: количество слов в отзыве\n","  - total_review_word_count: общее количество слов\n","  - has_negative_review: бинарный флаг наличия негативного отзыва\n"]},{"output_type":"display_data","data":{"text/plain":["       pos_review_word_count  neg_review_word_count  has_negative_review\n","count             515402.000             515402.000           515402.000\n","mean                  16.328                 17.353                0.750\n","std                   21.561                 29.333                0.433\n","min                    0.000                  0.000                0.000\n","25% 