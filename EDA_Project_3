-------------------------------------------\n# Используем быстрые строковые операции вместо медленного literal_eval\n# Пример: \"[ ' Tag 1 ', ' Tag 2 ' ]\" -> [' Tag 1 ', ' Tag 2 '] -> ['Tag 1', 'Tag 2']\ndf['tags_list'] = df['tags'].str.slice(1, -1).str.split(\"', '\")\ndf['tags_list'] = df['tags_list'].apply(lambda tag_list: [tag.strip() for tag in tag_list])\n\nprint(\"✅ Теги успешно распарсены в списки.\")\n\n# -----------------------------------------------------------------------------\n# 5.2. СОЗДАНИЕ НОВЫХ ПРИЗНАКОВ ИЗ ТЕГОВ\n# -----------------------------------------------------------------------------\n# 1. Количество тегов\ndf['num_tags'] = df['tags_list'].apply(len)\n\n# 2. Длительность пребывания (очень важный признак!)\ndef extract_nights(tag_list):\n    for tag in tag_list:\n        if 'Stayed' in tag and 'night' in tag:\n            try:\n                return int(tag.split()[1])\n            except (ValueError, IndexError):\n                return np.nan # На случай, если формат неожиданный\n    return np.nan # Если тег о длительности отсутствует\n\ndf['nights_stayed'] = df['tags_list'].apply(extract_nights)\n# Заполним пропуски медианным значением, т.к. это более устойчиво к выбросам\ndf['nights_stayed'].fillna(df['nights_stayed'].median(), inplace=True)\n\n# 3. Тип поездки (Leisure/Business)\ndef extract_trip_type(tag_list):\n    if 'Leisure trip' in tag_list:\n        return 'Leisure'\n    if 'Business trip' in tag_list:\n        return 'Business'\n    return 'Other'\n\ndf['trip_type'] = df['tags_list'].apply(extract_trip_type)\n\n# 4. Тип путешественника (Couple/Solo/etc.)\ndef extract_traveler_type(tag_list):\n    if 'Couple' in tag_list:\n        return 'Couple'\n    if 'Solo traveler' in tag_list:\n        return 'Solo'\n    if 'Family with young children' in tag_list:\n        return 'Family (young)'\n    if 'Family with older children' in tag_list:\n        return 'Family (older)'\n    if 'Group' in tag_list:\n        return 'Group'\n    return 'Other'\n\ndf['traveler_type'] = df['tags_list'].apply(extract_traveler_type)\n\nprint(\"✅ Созданы и добавлены новые признаки из тегов:\")\nprint(\"  - 'num_tags': Количество тегов\")\nprint(\"  - 'nights_stayed': Длительность пребывания (ночей)\")\nprint(\"  - 'trip_type': Тип поездки (Leisure/Business)\")\nprint(\"  - 'traveler_type': Тип путешественника (Couple/Solo/etc.)\")\ndisplay(df[['num_tags', 'nights_stayed', 'trip_type', 'traveler_type']].head())\n\n# -----------------------------------------------------------------------------\n# 5.3. АНАЛИЗ И ВИЗУАЛИЗАЦИЯ САМЫХ ПОПУЛЯРНЫХ ТЕГОВ\n# -----------------------------------------------------------------------------\n# Используем .explode() для превращения списка тегов в строки\nall_tags_series = df['tags_list'].explode()\ntop_30_tags = all_tags_series.value_counts().head(30)\n\nprint(\"\\n📊 Топ-30 самых популярных тегов:\")\ndisplay(top_30_tags)\n\nplt.figure(figsize=(12, 10))\nsns.barplot(x=top_30_tags.values, y=top_30_tags.index, palette='rocket', orient='h')\nplt.title('Топ-30 самых популярных тегов', fontsize=16)\nplt.xlabel('Количество упоминаний', fontsize=12)\nplt.ylabel('Тег', fontsize=12)\nplt.grid(axis='x', linestyle='--', alpha=0.7)\nplt.show()\n","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"Kbc3OW9Oe0j5","outputId":"39c15841-c9d6-4ad0-d5eb-5263217d7622"},"outputs":[{"output_type":"stream","name":"stdout","text":["--- 🏷️ Анализ тегов и декомпозиция на признаки ---\n","✅ Теги успешно распарсены в списки.\n","✅ Созданы и добавлены новые признаки из тегов:\n","  - 'num_tags': Количество тегов\n","  - 'nights_stayed': Длительность пребывания (ночей)\n","  - 'trip_type': Тип поездки (Leisure/Business)\n","  - 'traveler_type': Тип путешественника (Couple/Solo/etc.)\n"]},{"output_type":"display_data","data":{"text/plain":["   num_tags  nights_stayed trip_type traveler_type\n","0         5          2.000     Other        Couple\n","1         4          1.000     Other