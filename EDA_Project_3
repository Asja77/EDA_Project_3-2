mean()\nmedian_score = df[df['is_train'] == 1]['reviewer_score'].median()\nstd_score = df[df['is_train'] == 1]['reviewer_score'].std()\nprint(f\"*   **Средняя оценка:** {mean_score:.2f}, **Медиана:** {median_score:.2f}\")\nprint(f\"*   **Вывод:** Распределение сильно смещено влево (левосторонняя асимметрия), что говорит о преобладании высоких оценок. Модели, устойчивые к ненормальному распределению (например, деревья решений), будут работать лучше.\")\n\n# -----------------------------------------------------------------------------\n# 🌍 2. ГЕОГРАФИЯ И ПОПУЛЯРНОСТЬ\n# -----------------------------------------------------------------------------\nprint(\"\\n### 🌍 2. География и Популярность\")\ntop_city = df['hotel_city'].value_counts().index[0]\ntop_city_count = df['hotel_city'].value_counts().iloc[0]\nprint(f\"*   **Всего городов в выборке:** {df['hotel_city'].nunique()}\")\nprint(f\"*   **Лидер по числу отзывов:** **{top_city}** ({top_city_count:,} отзывов), что составляет значительную часть датасета.\")\nprint(f\"*   **Вывод:** Существует сильный дисбаланс по городам. Созданные нами признаки `city_mean_score` и `city_review_count` помогут модели уловить эту разницу и использовать популярность города как фактор.\")\ndisplay(df['hotel_city'].value_counts().head().to_frame('Кол-во отзывов'))\n\n# -----------------------------------------------------------------------------\n# ✍️ 3. ТЕКСТОВЫЕ ОТЗЫВЫ\n# -----------------------------------------------------------------------------\nprint(\"\\n### ✍️ 3. Текстовые Отзывы\")\n# Предполагаем, что corr_neg и corr_pos были посчитаны на предыдущем шаге\ncorr_neg = df[df['is_train'] == 1]['neg_review_word_count'].corr(df[df['is_train'] == 1]['reviewer_score'])\ncorr_pos = df[df['is_train'] == 1]['pos_review_word_count'].corr(df[df['is_train'] == 1]['reviewer_score'])\nprint(f\"*   **Ключевой инсайт:** Негативные отзывы гораздо более информативны, чем позитивные.\")\nprint(f\"*   **Сила негатива:** Корреляция с оценкой для негативных отзывов ({corr_neg:.3f}) более чем в 2 раза сильнее, чем для позитивных ({corr_pos:.3f}).\")\nprint(f\"*   **Вывод:** Признаки, основанные на негативных отзывах (`neg_review_word_count`, `has_negative_review`), будут одними из самых важных для модели.\")\n\n# -----------------------------------------------------------------------------\n# 🔑 4. КЛЮЧЕВЫЕ ФАКТОРЫ ДЛЯ МОДЕЛИ\n# -----------------------------------------------------------------------------\nprint(\"\\n### 🔑 4. Ключевые Факторы для Модели (по силе линейной корреляции)\")\n# Предполагаем, что target_corr был посчитан ранее\ntop_factors = target_corr.abs().sort_values(ascending=False).head(6).drop('reviewer_score')\nfor factor, corr_value in top_factors.items():\n    sign = \"прямая (+)\" if target_corr[factor] > 0 else \"обратная (-)\"\n    print(f\"*   **{factor}:** корреляция {abs(target_corr[factor]):.3f} ({sign})\")\nprint(f\"*   **Вывод:** История оценок отеля (`average_score`) и анализ негативных отзывов — два столпа, на которых будет строиться предсказание.\")\n\n# -----------------------------------------------------------------------------\n# 🧠 5. СТРАТЕГИЯ МОДЕЛИРОВАНИЯ\n# -----------------------------------------------------------------------------\nprint(\"\\n### 🧠 5. Стратегия Моделирования\")\nprint(\"*   **Алгоритм:** Использовать **CatBoostRegressor**. Он идеально подходит, так как:\")\nprint(\"    *   Нативно работает с категориальными признаками (мы создали `hotel_city`, `trip_type`, `traveler_type`).\")\nprint(\"    *   Устойчив к выбросам и не требует масштабирования числовых признаков.\")\nprint(\"    *   Отлично находит сложные, нелинейные зависимости.\")\nprint(\"*   **Признаки (Features):** Использовать все созданные нами признаки:\")\nprint(\"    *   **Гео-признаки:** `city_mean_score`, `country_mean_score`, etc.\")\nprint(\"    *   **Текстовые признаки:** `neg_review_word_count`, `has_negative_review`, etc.\")\nprint(\"    *   **Признаки из тегов:** `nights_stayed`, `trip_ty